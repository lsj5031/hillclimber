(in-package :hillclimber)

;; Exact decimal grammar, no Lisp reader applied to benchmark output.
(defun decimal (s)
  (let ((i 0) (n (length s)) (sign 1) (digits 0) (fraction 0) (count 0) (exponent 0) (exp-sign 1))
    (labels ((peek () (when (< i n) (char s i)))
             (take () (prog1 (peek) (incf i)))
             (digit () (and (peek) (digit-char-p (peek) 10)))
             (consume (&optional fractional)
               (loop while (digit) do
                 (setf digits (+ (* digits 10) (digit-char-p (take) 10)))
                 (incf count) (when fractional (incf fraction)))))
      (when (and (peek) (find (peek) "+-")) (when (char= (take) #\-) (setf sign -1)))
      (consume)
      (when (eql (peek) #\.) (take) (let ((before count)) (consume t)
                                        (when (= before count) (return-from decimal nil))))
      (when (zerop count) (return-from decimal nil))
      (when (and (peek) (find (peek) "eE"))
        (take)
        (when (and (peek) (find (peek) "+-")) (when (char= (take) #\-) (setf exp-sign -1)))
        (unless (digit) (return-from decimal nil))
        (loop while (digit) do (setf exponent (+ (* exponent 10) (digit-char-p (take) 10)))
              (when (> exponent 400) (return-from decimal nil))))
      (unless (and (= i n) (<= count 256)) (return-from decimal nil))
      (let ((power (- (* exp-sign exponent) fraction)))
        (handler-case
            (let ((value (coerce (* sign digits (expt 10 power)) 'double-float)))
              (when (and (or (zerop digits) (not (zerop value)))
                         (<= (abs value) most-positive-double-float)
                         (not (sb-ext:float-nan-p value))) value))
          (error () nil))))))

(defun metric-name-p (name)
  (and (plusp (length name))
       (every (lambda (c) (or (alphanumericp c) (find c "_.-µμ"))) name)))
(defun metrics (output)
  (let ((result (obj)) (duplicates nil))
    (dolist (line (lines output))
      (when (and (>= (length line) 7) (string= line "METRIC " :end1 7))
        (let* ((body (subseq line 7)) (eq (position #\= body)))
          (unless (and eq (metric-name-p (subseq body 0 eq))
                       (decimal (subseq body (1+ eq))))
            (fail "metric-format" (format nil "Invalid METRIC line: ~a" line)
                  "Print METRIC name=finite_decimal; see run --help." 4))
          (let ((name (subseq body 0 eq)))
            (when (gethash name result) (push name duplicates))
            (setf (gethash name result) (decimal (subseq body (1+ eq))))))))
    (values result (arr (nreverse duplicates)))))

(defun median (samples &optional legacy)
  (let* ((v (sort (copy-list samples) #'<)) (n (length v)) (mid (floor n 2)))
    (if (oddp n) (nth mid v)
        ;; Average exactly before rounding, avoiding overflow and loss of
        ;; subnormal halves even when both finite endpoints are extreme.
        (let ((a (nth (1- mid) v)) (b (nth mid v)))
          ;; Legacy arithmetic is used only to validate already-written v1
          ;; evidence; new measurements always use the exact midpoint.
          (if legacy (coerce (/ (+ a b) 2) 'double-float)
              (if (eql a b) a
                  (coerce (/ (+ (rational a) (rational b)) 2) 'double-float)))))))

(defun capture-fd (fd file)
  (let ((seen 0) (saved 0) (limit 65536)
        (stream (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8)))
        (buffer (make-array 4096 :element-type '(unsigned-byte 8))))
    (unwind-protect
         (with-open-file (out file :direction :output :if-exists :supersede
                              :element-type '(unsigned-byte 8))
           (loop for count = (read-sequence buffer stream) while (plusp count)
                 do (incf seen count)
                    (let ((take (min count (- limit saved))))
                      (when (plusp take)
                        (write-sequence buffer out :end take) (incf saved take)))
                 finally (sync-stream out)))
      (close stream))
    (obj "bytes" seen "saved" saved "truncated" (bool (> seen saved)))))
(defun log-text (file)
  (with-open-file (f file :element-type '(unsigned-byte 8))
    (let* ((buf (make-array (file-length f) :element-type '(unsigned-byte 8)))
           (n (read-sequence buf f)))
      (sb-ext:octets-to-string buf :end n :external-format '(:utf-8 :replacement #\?)))))
(defun monotime () (/ (get-internal-real-time) internal-time-units-per-second))
(sb-alien:define-alien-routine ("execv" native-execv) sb-alien:int
  (file sb-alien:c-string) (argv (* sb-alien:c-string)))
(defun execute-script (root script run-dir label timeout)
  (let* ((out-file (path run-dir (format nil "~a.stdout" label)))
         (err-file (path run-dir (format nil "~a.stderr" label)))
         (start (monotime)))
    (multiple-value-bind (out-r out-w) (sb-posix:pipe)
      (multiple-value-bind (err-r err-w) (sb-posix:pipe)
        (let ((pid (sb-posix:fork)))
          (when (zerop pid)
            (handler-case
                (progn
                  (sb-posix:setsid)
                  (sb-posix:close out-r) (sb-posix:close err-r)
                  (sb-posix:dup2 out-w 1) (sb-posix:dup2 err-w 2)
                  (sb-posix:close out-w) (sb-posix:close err-w)
                  (let ((null-fd (sb-posix:open "/dev/null" sb-posix:o-rdonly 0)))
                    (sb-posix:dup2 null-fd 0) (sb-posix:close null-fd))
                  (sb-posix:chdir root)
                  (let ((argv (sb-alien:make-alien sb-alien:c-string 3)))
                    (setf (sb-alien:deref argv 0) "/bin/sh"
                          (sb-alien:deref argv 1) (path root script)
                          (sb-alien:deref argv 2) nil)
                    (native-execv "/bin/sh" argv)
                    (sb-posix:_exit 127)))
              (error () (sb-posix:_exit 127))))
          (sb-posix:close out-w) (sb-posix:close err-w)
          (let* ((a (sb-thread:make-thread (lambda () (capture-fd out-r out-file)) :name "stdout-drain"))
                 (b (sb-thread:make-thread (lambda () (capture-fd err-r err-file)) :name "stderr-drain"))
                 (status nil) (timed-out nil) (stdout nil) (stderr nil))
            (unwind-protect
                 (progn
                   (loop
                     (multiple-value-bind (found code) (sb-posix:waitpid pid sb-posix:wnohang)
                       (when (= found pid) (setf status code) (return)))
                     (when (>= (- (monotime) start) timeout)
                       (setf timed-out t) (return))
                     (sleep 0.02))
                   (when timed-out
                     (ignore-errors (sb-posix:kill (- pid) sb-posix:sigterm))
                     (sleep 0.2)
                     (ignore-errors (sb-posix:kill (- pid) sb-posix:sigkill))
                     (multiple-value-bind (found code) (sb-posix:waitpid pid 0)
                       (declare (ignore found)) (setf status code))))
              ;; Reap descendants still in the group before joining readers.
              (ignore-errors (sb-posix:kill (- pid) sb-posix:sigterm))
              (sleep 0.02)
              (ignore-errors (sb-posix:kill (- pid) sb-posix:sigkill))
              (unless status
                (multiple-value-bind (found code) (sb-posix:waitpid pid 0)
                  (declare (ignore found)) (setf status code)))
              (setf stdout (sb-thread:join-thread a)
                    stderr (sb-thread:join-thread b)))
            (obj "exit" (if (and status (sb-posix:wifexited status))
                              (sb-posix:wexitstatus status) :null)
                   "timeout" (bool timed-out)
                   "seconds" (- (monotime) start)
                   "stdout" stdout "stderr" stderr
                   "stdout_tail" (let ((s (log-text out-file))) (subseq s (max 0 (- (length s) 2048))))
                   "stderr_tail" (let ((s (log-text err-file))) (subseq s (max 0 (- (length s) 2048)))))))))))
