(in-package :hillclimber)
(defun test-astra-median ()
  (dolist (value (list most-positive-double-float most-negative-double-float
                       least-positive-double-float least-negative-double-float
                       1d308 -1d308 0d0 -0d0))
    (assert (eql (median (list value value)) value)))
  (assert (= (median (list most-negative-double-float most-positive-double-float)) 0d0))
  (assert (= (median (list least-positive-double-float
                          (* 3 least-positive-double-float)))
             (* 2 least-positive-double-float)))
  (assert (= (median '(1d308 1.6d308)) 1.3d308))
  (assert (= (median '(-1.6d308 -1d308)) -1.3d308))
  (assert (= (median '(-8d0 -2d0 4d0 10d0)) 1d0))
  (format *error-output* "Astra median assertions passed.~%"))
(defun test-core-command-resources ()
  (let ((directory (path (asdf:system-source-directory "hillclimber") "scratch/")))
    (ensure-directories-exist directory)
    (labels ((descriptors ()
               (loop for fd below 256 count (ignore-errors (sb-posix:fcntl fd sb-posix:f-getfd))))
             (command (script) (run-cmd "/bin/sh" (list "-c" script) :directory directory)))
      (let ((before (descriptors)))
        (dotimes (i 20)
          (multiple-value-bind (out code err) (command "printf out; printf err >&2; exit 7")
            (assert (equal out "out")) (assert (= code 7)) (assert (equal err "err"))))
        (assert (= before (descriptors))))
      ;; Exercise an exception after both streams have been drained.
      (let ((before (descriptors)) (caught nil))
        (handler-case (command "head -c 70000 /dev/zero >&2")
          (cli-error (e) (setf caught (equal (err-code e) "git-output-limit"))))
        (assert caught)
        (assert (= before (descriptors))))
      ;; A failed drain kills/reaps the child, propagates the original error
      ;; on the caller thread, and still closes both owned streams.
      (let ((reader (symbol-function 'read-bounded)) (before (descriptors)) (caught nil))
        (unwind-protect
             (progn
               (setf (symbol-function 'read-bounded)
                     (lambda (&rest args) (declare (ignore args)) (error "injected drain failure")))
               (handler-case (command "exec sleep 10")
                 (simple-error (e)
                   (setf caught (search "injected drain failure" (princ-to-string e))))))
          (setf (symbol-function 'read-bounded) reader))
        (assert caught)
        (assert (= before (descriptors)))))))
(defun test-core ()
  (test-astra-median)
  (assert (= (decimal "-1.25e2") -125d0))
  (assert (null (decimal "NaN")))
  (assert (null (decimal "#x12")))
  (assert (null (decimal "1e9999")))
  (assert (null (decimal "1e-400")))
  (assert (= (decimal "0") 0d0))
  (assert (= (median '(1d0 5d0 3d0)) 3d0))
  (multiple-value-bind (parsed duplicates)
      (metrics (format nil "METRIC µs=-2e1~%METRIC µs=0~%"))
    (assert (= (field parsed "µs") 0d0))
    (assert (equalp duplicates #("µs"))))
  (assert (equal (field (parse-json (json (obj "unicode" "µ" "missing" :null))) "unicode") "µ"))
  (test-core-command-resources)
  (format *error-output* "Core ASDF assertions passed.~%"))
