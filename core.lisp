(in-package :hillclimber)

(define-condition cli-error (error)
  ((code :initarg :code :reader err-code)
   (message :initarg :message :reader err-message)
   (next :initarg :next :reader err-next)
   (exit :initarg :exit :reader err-exit)))
(defun fail (code message next &optional (exit 3))
  (error 'cli-error :code code :message message :next next :exit exit))

(defun obj (&rest pairs)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (k v) on pairs by #'cddr do (setf (gethash k h) v))
    h))
(defun field (o key &optional default) (if (hash-table-p o) (gethash key o default) default))
(defun json (value) (yason:with-output-to-string* () (yason:encode value)))
(defun parse-json (line)
  (let ((yason:*parse-json-arrays-as-vectors* t)
        (yason:*parse-json-booleans-as-symbols* t)
        (yason:*parse-json-null-as-keyword* t))
    (yason:parse line)))
(defun arr (list) (coerce list 'vector))
(defun bool (x) (if x yason:true yason:false))

(defun path (root relative) (namestring (merge-pathnames relative (uiop:ensure-directory-pathname root))))
(defun lines (string)
  (loop for start = 0 then (1+ end)
        for end = (position #\Newline string :start start)
        collect (subseq string start end) while end))
(defun nul-list (string)
  (loop for start = 0 then (1+ end)
        for end = (position #\Null string :start start)
        while end collect (subseq string start end)))
(defun read-bounded (stream limit)
  (let ((buffer (make-string 4096)) (count 0) (truncated nil))
    (values
     (with-output-to-string (output)
       (loop for n = (read-sequence buffer stream) while (plusp n)
             do (let ((size (min n (max 0 (- limit count)))))
                  (write-string buffer output :end size)
                  (incf count size)
                  (when (< size n) (setf truncated t)))))
     truncated)))
(defun run-cmd (program args &key directory)
  (let* ((p (sb-ext:run-program program args :search nil :wait nil
                                 :input nil :output :stream :error :stream
                                 :external-format :utf-8 :directory directory))
         (stdout nil) (stderr nil))
    (labels ((drain (stream limit)
               (handler-case (multiple-value-list (read-bounded stream limit))
                 (error (e)
                   ;; A failed reader must not leave Git blocked on a full pipe.
                   (ignore-errors (sb-ext:process-kill p 9))
                   e)))
             (result (thread)
               (let ((value (sb-thread:join-thread thread)))
                 (if (typep value 'error) (error value) value))))
      (unwind-protect
           (progn
             (setf stdout (sb-thread:make-thread
                           (lambda () (drain (sb-ext:process-output p) (* 8 1024 1024))))
                   stderr (sb-thread:make-thread
                           (lambda () (drain (sb-ext:process-error p) 65536))))
             (sb-ext:process-wait p)
             (destructuring-bind (out out-cut) (result stdout)
               (destructuring-bind (err err-cut) (result stderr)
                 (when (or out-cut err-cut)
                   (fail "git-output-limit" "Git output exceeded safe capture limits."
                         "Reduce the worktree or inspect verbose Git hooks." 5))
                 (values out (sb-ext:process-exit-code p) err))))
        (unwind-protect
             (progn
               (when (sb-ext:process-alive-p p)
                 (ignore-errors (sb-ext:process-kill p 9)))
               (ignore-errors (sb-ext:process-wait p))
               (dolist (thread (list stdout stderr))
                 (when thread (ignore-errors (sb-thread:join-thread thread :default nil)))))
          (sb-ext:process-close p))))))
(defun git (root &rest args)
  (multiple-value-bind (out status err)
      (run-cmd "/usr/bin/git" (append (list "-C" root "--literal-pathspecs") args))
    (unless (zerop status)
      (fail "git" (format nil "git ~{~a ~} failed: ~a" args err)
            "Inspect Git status and hooks; run hillclimber recover if a decision was interrupted." 5))
    out))
(defun trim (s) (string-right-trim '(#\Newline #\Return) s))
(defun git-head (root) (trim (git root "rev-parse" "HEAD")))
(defun root-path (given)
  (let* ((dir (truename (uiop:ensure-directory-pathname given)))
         (root (trim (git (namestring dir) "rev-parse" "--show-toplevel"))))
    (unless (equal (namestring dir) (namestring (truename (uiop:ensure-directory-pathname root))))
      (fail "project-root" "Project must be the exact Git worktree root, not a subdirectory."
            "Pass --project with the worktree root."))
    (namestring dir)))
(defun command-status (root)
  (nul-list (git root "status" "--porcelain=v1" "-z" "--untracked-files=all")))
(defun clean-p (root) (null (command-status root)))
(defun clean-required (root)
  (unless (clean-p root)
    (fail "dirty-worktree" "The worktree or index is not clean."
          "Commit or remove unrelated changes yourself before init/begin; use decide for a pending candidate.")))
(defun safe-relative (p)
  (and (stringp p) (> (length p) 0)
       (not (char= (char p 0) #\/))
       (not (find #\Null p))
       (not (member "." (uiop:split-string p :separator "/") :test #'equal))
       (not (member ".." (uiop:split-string p :separator "/") :test #'equal))
       (not (member "" (uiop:split-string p :separator "/") :test #'equal))
       (not (member (car (uiop:split-string p :separator "/")) '(".git" ".auto") :test #'equal))))
(defun within (file scope)
  (some (lambda (s) (or (equal file s)
                        (and (> (length file) (length s))
                             (string= file s :end1 (length s))
                             (char= (char file (length s)) #\/))))
        scope))
(defun status-entries (root)
  (let ((items (command-status root)) (result nil))
    (loop while items for entry = (pop items)
          for kind = (subseq entry 0 2)
          for file = (subseq entry 3)
          do (when (or (find #\R kind) (find #\C kind))
               (fail "unsupported-git-change" "Renames and copies are not supported."
                     "Restore or commit the rename outside a candidate."))
             (push (cons kind file) result))
    (nreverse result)))
(defun scoped-changes (root scope)
  (let ((entries (status-entries root)))
    (dolist (e entries)
      (unless (within (cdr e) scope)
        (fail "outside-scope" (format nil "Change outside declared scope: ~a" (cdr e))
              "Restore the unrelated change yourself; only scope paths belong to this candidate."))
      (unless (or (string= (car e) "??") (char= (char (car e) 0) #\Space))
        (fail "staged-change" "Staged changes are not owned by hillclimber."
              "Unstage manually and retry.")))
    entries))
(defun file-mode (filename)
  (let ((info (sb-posix:lstat filename)))
    (unless (= (logand (sb-posix:stat-mode info) sb-posix:s-ifmt) sb-posix:s-ifreg)
      (fail "unsupported-file" (format nil "Only ordinary files are supported: ~a" filename)
            "Remove symlinks, submodules and nested repositories from candidate changes."))
    (if (plusp (logand (sb-posix:stat-mode info) #o111)) "executable" "regular")))
(defun hash-file (filename)
  (trim (multiple-value-bind (out status err)
            (run-cmd "/usr/bin/git" (list "hash-object" "--" filename))
          (unless (zerop status) (fail "fingerprint" err "Inspect protected files and permissions." 5))
          out)))
(defun fingerprint (root entries)
  (arr (mapcar (lambda (e)
                 (let* ((name (cdr e)) (file (path root name))
                        (exists (ignore-errors (sb-posix:lstat file))))
                   (when (and (equal (car e) "??") (not exists))
                     (fail "source-drift" "A new file disappeared during fingerprinting."
                           "Run again when edits are stable."))
                   (obj "path" name "status" (car e) "mode" (if exists (file-mode file) "deleted")
                        "hash" (if exists (hash-file file) :null))))
               entries)))
(defun same-json (a b) (string= (json a) (json b)))
(defun protected-fingerprint (root session)
  (arr (map 'list (lambda (name)
                    (let ((file (path root name)))
                      (unless (probe-file file)
                        (fail "protected-missing" (format nil "Protected input is missing: ~a" name)
                              "Restore it or initialize a new session."))
                      (obj "path" name "hash" (hash-file file) "mode" (file-mode file))))
            (field session "protected"))))
(defun inside-project (root file)
  (let ((real (namestring (truename (path root file)))))
    (unless (and (<= (length root) (length real))
                 (string= root real :end2 (length root)))
      (fail "path-escape" (format nil "Path resolves outside project: ~a" file)
            "Use only project-owned regular paths." 2))))
(defun validate-identity (root session)
  (unless (and (equal root (field session "root"))
               (equal (trim (git root "rev-parse" "--git-dir"))
                      (field session "git-dir"))
               (equal (trim (git root "symbolic-ref" "--quiet" "--short" "HEAD"))
                      (field session "branch")))
    (fail "identity-drift" "Worktree identity or branch changed."
          "Return to the original worktree and branch; do not reset Git during a candidate.")))
(defun protected-required (root session)
  (unless (same-json (protected-fingerprint root session) (field session "fingerprint"))
    (fail "evaluator-drift" "Protected benchmark/check/input changed."
          "Restore the protected evaluator or start a fresh session and baseline.")))

(defun session-file (root) (path root ".auto/session.json"))
(defun events-file (root) (path root ".auto/events.jsonl"))
(defun load-session (root)
  (unless (probe-file (session-file root))
    (fail "no-session" "No hillclimber session exists in this worktree."
          "Run hillclimber init once, or pass --project with the session worktree."))
  (handler-case (parse-json (uiop:read-file-string (session-file root)))
    (error () (fail "session-corrupt" "Invalid session.json." "Restore the session file from backup." 5))))
(defun sync-stream (stream)
  (finish-output stream)
  (sb-posix:fsync (sb-sys:fd-stream-fd stream)))
(defun sync-directory (directory)
  (let ((fd (sb-posix:open (namestring (uiop:ensure-directory-pathname directory))
                           sb-posix:o-rdonly 0)))
    (unwind-protect (sb-posix:fsync fd)
      (sb-posix:close fd))))
(defun write-json-file (name value)
  (with-open-file (f name :direction :output :if-exists :error :external-format :utf-8)
    (write-line (json value) f) (sync-stream f)))
(defun append-event (root event)
  (setf (gethash "v" event) 1)
  (with-open-file (f (events-file root) :direction :output :if-exists :append
                                           :external-format :utf-8)
    (write-line (json event) f) (sync-stream f))
  event)
(defun journal-bytes (root)
  (unless (probe-file (events-file root))
    (fail "journal-missing" "Missing events journal." "Restore session events from backup." 5))
  (with-open-file (f (events-file root) :element-type '(unsigned-byte 8))
    (let ((buf (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence buf f) buf)))
(defun journal-prefix (bytes)
  (or (position 10 bytes :from-end t) -1))
(defun journal-corrupt ()
  (fail "journal-corrupt" "Journal has an invalid complete record or transition."
        "Preserve its bytes and restore a trusted backup; mutation is blocked." 5))
(defun finite-score-p (x)
  (and (realp x) (<= (- most-positive-double-float) x most-positive-double-float)))
(defun nonempty-string-p (x) (and (stringp x) (plusp (length x))))
(defun object-id-p (x)
  (and (stringp x) (member (length x) '(40 64))
       (every (lambda (c) (find c "0123456789abcdef")) x)))
(defun journal-array-p (x) (typep x '(vector t)))
(defun fingerprint-p (x &optional changed)
  (and (journal-array-p x)
       (every (lambda (e)
                (let ((name (field e "path")) (mode (field e "mode")) (hash (field e "hash")))
                  (and (hash-table-p e)
                       (or (safe-relative name)
                           (and (not changed)
                                (member name '(".auto/measure.sh" ".auto/checks.sh") :test #'equal)))
                       (if (equal mode "deleted")
                           (and changed (eq hash :null) (equal (field e "status") " D"))
                           (and (member mode '("regular" "executable") :test #'equal)
                                (object-id-p hash)))
                       (or (not changed)
                           (member (field e "status") '("??" " M" " D" " T" " A") :test #'equal)))))
              x)
       ;; v1 protected lists may repeat --input or evaluator paths. Repeated
       ;; evidence must agree; changed-source paths still have one owner.
       (let ((seen (make-hash-table :test 'equal)))
         (every (lambda (e)
                  (let* ((name (field e "path")) (previous (gethash name seen)))
                    (setf (gethash name seen) e)
                    (or (not previous)
                        (and (not changed)
                             (equal (field e "hash") (field previous "hash"))
                             (equal (field e "mode") (field previous "mode"))))))
                x))))
(defun process-evidence-p (e)
  (labels ((capture (x)
             (and (hash-table-p x)
                  (integerp (field x "bytes")) (>= (field x "bytes") 0)
                  (integerp (field x "saved"))
                  (= (field x "saved") (min (field x "bytes") 65536))
                  (eq (field x "truncated") (bool (> (field x "bytes") 65536))))))
    (and (hash-table-p e)
         (or (eq (field e "exit") :null)
             (and (integerp (field e "exit")) (<= 0 (field e "exit") 255)))
         (member (field e "timeout") (list yason:true yason:false))
         (finite-score-p (field e "seconds")) (>= (field e "seconds") 0)
         (capture (field e "stdout")) (capture (field e "stderr"))
         (stringp (field e "stdout_tail")) (stringp (field e "stderr_tail")))))
(defun passing-process-p (e)
  (and (eql (field e "exit") 0) (eq (field e "timeout") yason:false)))
(defun valid-event-p (e)
  ;; Validate the v1 writer vocabulary, not a general JSON schema. Recovery's
  ;; interrupted attempt deliberately has no source/metrics/process evidence.
  (labels ((value (key predicate) (funcall predicate (field e key)))
           (strings (x) (and (journal-array-p x) (every #'nonempty-string-p x)))
           (samples (x) (and (journal-array-p x) (plusp (length x)) (every #'finite-score-p x)))
           (metrics-p (x) (and (hash-table-p x)
                               (loop for k being the hash-keys of x using (hash-value v)
                                     always (and (nonempty-string-p k) (finite-score-p v)))))
           (scored () (and (value "score" #'finite-score-p)
                             (value "mad" (lambda (x) (and (finite-score-p x) (>= x 0))))
                             (value "samples" #'samples) (value "metrics" #'metrics-p)
                             (value "secondary_missing" #'strings)))
           (candidate () (or (eq (field e "candidate") :null)
                              (value "candidate" #'nonempty-string-p)))
           (decision () (and (value "id" #'nonempty-string-p)
                              (value "decision" #'nonempty-string-p)
                              (member (field e "action") '("keep" "discard") :test #'equal)
                              (value "head" #'object-id-p)))
           (decision-score () (if (equal (field e "action") "keep")
                                    (value "score" #'finite-score-p)
                                    (eq (field e "score") :null))))
    (and (hash-table-p e) (eql (field e "v") 1)
         (value "at" (lambda (x) (and (integerp x) (>= x 0))))
         (let ((type (field e "type")))
           (cond
             ((equal type "baseline")
              (and (scored) (value "head" #'object-id-p) (eql (field e "count") 0)))
             ((equal type "begin")
              (and (value "id" #'nonempty-string-p) (value "head" #'object-id-p)
                   (value "hypothesis" #'nonempty-string-p)
                   (value "scope" (lambda (x) (and (journal-array-p x) (plusp (length x))
                                                   (every #'safe-relative x))))
                   (value "protected" #'fingerprint-p)))
             ((equal type "attempt-start")
              (and (value "id" #'nonempty-string-p) (candidate)))
             ((equal type "attempt")
              (and (value "id" #'nonempty-string-p) (candidate)
                   (or (eq (field e "score") :null) (value "score" #'finite-score-p))
                   (or (eq (field e "error") :null) (value "error" #'stringp))
                   (if (gethash "source" e)
                       (and (fingerprint-p (field e "source") t)
                            (value "metrics" #'metrics-p) (value "duplicates" #'strings)
                            (value "benchmark" #'process-evidence-p)
                            (or (eq (field e "checks") :null) (value "checks" #'process-evidence-p))
                            (or (eq (field e "score") :null)
                                (and (passing-process-p (field e "benchmark"))
                                     (eq (field (field (field e "benchmark") "stdout") "truncated")
                                         yason:false)
                                     (or (eq (field e "checks") :null)
                                         (passing-process-p (field e "checks")))
                                     (eq (field e "error") :null))))
                       (and (eq (field e "score") :null)
                            (equal (field e "error") "Interrupted; execution budget consumed.")))))
             ((equal type "aggregate")
              (and (value "id" #'nonempty-string-p) (value "candidate" #'nonempty-string-p)
                   (fingerprint-p (field e "source") t) (scored)))
             ((equal type "intent")
              (and (decision) (decision-score) (value "reason" #'nonempty-string-p)
                   (fingerprint-p (field e "source") t)))
             ((equal type "cancel-intent") (value "id" #'nonempty-string-p))
             ((equal type "applied") (decision))
             ((equal type "resolved")
              (and (decision) (decision-score) (value "reason" #'nonempty-string-p))))))))
(defun journal (root &optional allow-tail)
  (let* ((bytes (journal-bytes root)) (end (1+ (journal-prefix bytes)))
         (events nil))
    (loop for start = 0 then (1+ newline)
          for newline = (position 10 bytes :start start :end end)
          while newline do
            (handler-case
                (let ((e (parse-json
                          (sb-ext:octets-to-string bytes :start start :end newline
                                                   :external-format :utf-8))))
                  (unless (valid-event-p e)
                    (error "invalid event"))
                  (push e events))
              (error () (journal-corrupt))))
    (setf events (nreverse events))
    ;; Recovery calls journal before backing up/trimming an incomplete tail.
    ;; Validate transitions here too, before any journal bytes can be changed.
    (let ((state (replay-journal events (field (load-session root) "metric"))))
      (when (and (< end (length bytes)) (not allow-tail))
        (fail "journal-truncated" "Journal ends in an incomplete record."
              "Run recover; it preserves the original bytes before trimming the final fragment." 5))
      (values events state))))
(defun replay-journal (events metric)
  (let ((baseline nil) (best nil) (accepted nil) (pending nil)
        (attempt nil) (intent nil) (applied nil) (runs 0) (candidates 0)
        (decisions 0) (history nil) (samples nil))
    (labels ((require-event (valid) (unless valid (journal-corrupt)))
             (candidate-matches (e)
               (equal (field e "candidate") (if pending (field pending "id") :null)))
             (decision-matches (e)
               (and intent (equal (field e "id") (field intent "id"))
                    (equal (field e "decision") (field intent "decision"))
                    (equal (field e "action") (field intent "action")))))
    (dolist (e events)
      (let ((type (field e "type")))
        (cond
          ((equal type "baseline")
           (require-event (and (not baseline) (not pending) attempt
                               (equal (field attempt "type") "attempt")
                               (finite-score-p (field attempt "score"))))
           (require-event (sample-evidence-p e samples))
           (setf baseline e best (field e "score") accepted (field e "head"))
           (setf samples nil)
           (incf runs (field e "count")))
          ((equal type "begin")
           (require-event (and baseline (not pending) (not intent)
                               (equal (field e "head") accepted)
                               (equal (field e "id") (format nil "c-~6,'0d" (1+ candidates)))))
           (setf pending e attempt nil intent nil applied nil samples nil)
           (incf candidates))
          ((equal type "attempt-start")
           (require-event (and (not intent) (candidate-matches e)
                               (or pending (not baseline))
                               (equal (field e "id") (format nil "r-~6,'0d" (1+ runs)))))
           ;; A caller may retry without recover; the old reservation stays
           ;; consumed, but cannot provide evidence for the new batch.
           (when (or (not attempt)
                     (not (equal (field attempt "type") "attempt"))
                     (not (finite-score-p (field attempt "score"))))
             (setf samples nil))
           (incf runs) (setf attempt e))
          ((equal type "attempt")
           (require-event (and (not intent) attempt (candidate-matches e)
                               (equal (field attempt "type") "attempt-start")
                               (equal (field e "id") (field attempt "id"))))
           (when (finite-score-p (field e "score"))
             (let ((primary (field (field e "metrics") metric)))
               (require-event (and (finite-score-p primary)
                                   (= (field e "score") primary)))))
           (when (gethash "source" e)
             (require-event (if pending
                                (every (lambda (x) (within (field x "path")
                                                           (coerce (field pending "scope") 'list)))
                                       (field e "source"))
                                (zerop (length (field e "source"))))))
           (push e samples)
           (setf attempt e) (push e history))
          ((equal type "aggregate")
           (require-event (and pending (not intent) attempt (candidate-matches e)
                               (equal (field attempt "type") "attempt")
                               (equal (field e "id") (field attempt "id"))
                               (sample-evidence-p e samples)))
           (setf samples nil)
           (setf attempt e) (push e history))
          ((equal type "intent")
           (require-event (and pending (not intent)
                               (equal (field e "id") (field pending "id"))
                               (equal (field e "head") accepted)
                               (equal (field e "decision") (format nil "d-~6,'0d" (1+ decisions)))
                               (every (lambda (x) (within (field x "path")
                                                          (coerce (field pending "scope") 'list)))
                                      (field e "source"))))
           (when (and attempt (gethash "source" attempt))
             (require-event (same-json (field e "source") (field attempt "source"))))
           (when (equal (field e "action") "keep")
             (require-event (and attempt
                                 (member (field attempt "type") '("attempt" "aggregate") :test #'equal)
                                 (equal (field e "score") (field attempt "score"))
                                 (plusp (length (field e "source"))))))
           (setf intent e) (incf decisions))
          ((equal type "cancel-intent")
           (require-event (and intent (not applied) (equal (field intent "action") "keep")
                               (equal (field e "id") (field intent "id"))))
           (setf intent nil))
          ((equal type "applied")
           (require-event (and (not applied) (decision-matches e)
                               (if (equal (field e "action") "discard")
                                   (equal (field e "head") accepted)
                                   (not (equal (field e "head") accepted)))))
           (setf applied e))
          ((equal type "resolved")
           (require-event (and applied (decision-matches e)
                               (equal (field e "head") (field applied "head"))
                               (equal (field e "score") (field intent "score"))
                               (equal (field e "reason") (field intent "reason"))))
           (when (equal (field e "action") "keep")
             (setf accepted (field e "head") best (field e "score")))
           (setf pending nil attempt nil intent nil applied nil samples nil) (push e history))))))
    (obj "baseline" (or baseline :null) "best" (or best :null)
         "accepted" (or accepted :null) "pending" (or pending :null)
         "attempt" (or attempt :null) "intent" (or intent :null)
         "applied" (or applied :null) "runs" runs "candidates" candidates
         "decisions" decisions
         "history" (arr (nreverse history)))))
(defun sample-evidence-p (event reversed-attempts)
  (let* ((scores (field event "samples")) (n (length scores))
         (attempts (reverse (subseq reversed-attempts 0 (min n (length reversed-attempts))))))
    (and (= n (length attempts))
         (every (lambda (score attempt)
                  (and (finite-score-p (field attempt "score"))
                       (= score (field attempt "score"))
                       (or (equal (field event "type") "baseline")
                           (same-json (field event "source") (field attempt "source")))))
                scores attempts)
         (labels ((matches (legacy)
                    (handler-case
                        (multiple-value-bind (score mad metrics missing)
                            (score-samples attempts legacy)
                          (and score (= score (field event "score"))
                               (= mad (field event "mad"))
                               (equalp metrics (field event "metrics"))
                               (equal (sort (coerce missing 'list) #'string<)
                                      (sort (coerce (field event "secondary_missing") 'list)
                                            #'string<))))
                      (arithmetic-error () nil)
                      (cli-error () nil))))
           ;; Before F8, v1 used rounded double sums/distances. Accept that
           ;; complete derived tuple too, not an epsilon around arbitrary data.
           (or (matches nil) (matches t))))))
(defun state (root &optional allow-tail)
  (nth-value 1 (journal root allow-tail)))
(defun real-field (o key) (let ((x (field o key))) (and (numberp x) x)))
(defun with-session-lock (root thunk)
  (with-open-file (s (path root ".auto/session.lock") :direction :io
                      :if-does-not-exist :create :if-exists :overwrite)
    (let ((fd (sb-sys:fd-stream-fd s)))
      (handler-case (sb-posix:lockf fd sb-posix:f-tlock 0)
        (error () (fail "locked" "Another hillclimber writer owns this session."
                        "Wait for it to finish; status is still available.")))
      (unwind-protect (funcall thunk)
        (sb-posix:lockf fd sb-posix:f-ulock 0)))))
