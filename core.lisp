(in-package :hillclimber)

(define-condition cli-error (error)
  ((code :initarg :code :reader err-code)
   (message :initarg :message :reader err-message)
   (next :initarg :next :reader err-next)
   (exit :initarg :exit :reader err-exit)))
(defun fail (code message next &optional (exit 3))
  (error 'cli-error :code code :message message :next next :exit exit))

(defun obj (&rest pairs)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (k v) on pairs by #'cddr do (setf (gethash k h) v))
    h))
(defun field (o key &optional default) (if (hash-table-p o) (gethash key o default) default))
(defun json (value) (yason:with-output-to-string* () (yason:encode value)))
(defun parse-json (line)
  (let ((yason:*parse-json-arrays-as-vectors* t)
        (yason:*parse-json-booleans-as-symbols* t)
        (yason:*parse-json-null-as-keyword* t))
    (yason:parse line)))
(defun arr (list) (coerce list 'vector))
(defun bool (x) (if x yason:true yason:false))

(defun path (root relative) (namestring (merge-pathnames relative (uiop:ensure-directory-pathname root))))
(defun lines (string)
  (loop for start = 0 then (1+ end)
        for end = (position #\Newline string :start start)
        collect (subseq string start end) while end))
(defun nul-list (string)
  (loop for start = 0 then (1+ end)
        for end = (position #\Null string :start start)
        while end collect (subseq string start end)))
(defun read-bounded (stream limit)
  (let ((buffer (make-string 4096)) (count 0) (truncated nil))
    (values
     (with-output-to-string (output)
       (loop for n = (read-sequence buffer stream) while (plusp n)
             do (let ((size (min n (max 0 (- limit count)))))
                  (write-string buffer output :end size)
                  (incf count size)
                  (when (< size n) (setf truncated t)))))
     truncated)))
(defun run-cmd (program args &key directory)
  (let* ((p (sb-ext:run-program program args :search nil :wait nil
                                 :input nil :output :stream :error :stream
                                 :external-format :utf-8 :directory directory))
         (stdout (sb-thread:make-thread
                  (lambda () (multiple-value-list
                              (read-bounded (sb-ext:process-output p) (* 8 1024 1024))))))
         (stderr (sb-thread:make-thread
                  (lambda () (multiple-value-list
                              (read-bounded (sb-ext:process-error p) 65536))))))
    (sb-ext:process-wait p)
    (destructuring-bind (out out-cut) (sb-thread:join-thread stdout)
      (destructuring-bind (err err-cut) (sb-thread:join-thread stderr)
        (when (or out-cut err-cut)
          (fail "git-output-limit" "Git output exceeded safe capture limits."
                "Reduce the worktree or inspect verbose Git hooks." 5))
        (values out (sb-ext:process-exit-code p) err)))))
(defun git (root &rest args)
  (multiple-value-bind (out status err)
      (run-cmd "/usr/bin/git" (append (list "-C" root "--literal-pathspecs") args))
    (unless (zerop status)
      (fail "git" (format nil "git ~{~a ~} failed: ~a" args err)
            "Inspect Git status and hooks; run hillclimber recover if a decision was interrupted." 5))
    out))
(defun trim (s) (string-right-trim '(#\Newline #\Return) s))
(defun git-head (root) (trim (git root "rev-parse" "HEAD")))
(defun root-path (given)
  (let* ((dir (truename (uiop:ensure-directory-pathname given)))
         (root (trim (git (namestring dir) "rev-parse" "--show-toplevel"))))
    (unless (equal (namestring dir) (namestring (truename (uiop:ensure-directory-pathname root))))
      (fail "project-root" "Project must be the exact Git worktree root, not a subdirectory."
            "Pass --project with the worktree root."))
    (namestring dir)))
(defun command-status (root)
  (nul-list (git root "status" "--porcelain=v1" "-z" "--untracked-files=all")))
(defun clean-p (root) (null (command-status root)))
(defun clean-required (root)
  (unless (clean-p root)
    (fail "dirty-worktree" "The worktree or index is not clean."
          "Commit or remove unrelated changes yourself before init/begin; use decide for a pending candidate.")))
(defun safe-relative (p)
  (and (stringp p) (> (length p) 0)
       (not (char= (char p 0) #\/))
       (not (find #\Null p))
       (not (member "." (uiop:split-string p :separator "/") :test #'equal))
       (not (member ".." (uiop:split-string p :separator "/") :test #'equal))
       (not (member "" (uiop:split-string p :separator "/") :test #'equal))
       (not (member (car (uiop:split-string p :separator "/")) '(".git" ".auto") :test #'equal))))
(defun within (file scope)
  (some (lambda (s) (or (equal file s)
                        (and (> (length file) (length s))
                             (string= file s :end1 (length s))
                             (char= (char file (length s)) #\/))))
        scope))
(defun status-entries (root)
  (let ((items (command-status root)) (result nil))
    (loop while items for entry = (pop items)
          for kind = (subseq entry 0 2)
          for file = (subseq entry 3)
          do (when (or (find #\R kind) (find #\C kind))
               (fail "unsupported-git-change" "Renames and copies are not supported."
                     "Restore or commit the rename outside a candidate."))
             (push (cons kind file) result))
    (nreverse result)))
(defun scoped-changes (root scope)
  (let ((entries (status-entries root)))
    (dolist (e entries)
      (unless (within (cdr e) scope)
        (fail "outside-scope" (format nil "Change outside declared scope: ~a" (cdr e))
              "Restore the unrelated change yourself; only scope paths belong to this candidate."))
      (unless (or (string= (car e) "??") (char= (char (car e) 0) #\Space))
        (fail "staged-change" "Staged changes are not owned by hillclimber."
              "Unstage manually and retry.")))
    entries))
(defun file-mode (filename)
  (let ((info (sb-posix:lstat filename)))
    (unless (= (logand (sb-posix:stat-mode info) sb-posix:s-ifmt) sb-posix:s-ifreg)
      (fail "unsupported-file" (format nil "Only ordinary files are supported: ~a" filename)
            "Remove symlinks, submodules and nested repositories from candidate changes."))
    (if (plusp (logand (sb-posix:stat-mode info) #o111)) "executable" "regular")))
(defun hash-file (filename)
  (trim (multiple-value-bind (out status err)
            (run-cmd "/usr/bin/git" (list "hash-object" "--" filename))
          (unless (zerop status) (fail "fingerprint" err "Inspect protected files and permissions." 5))
          out)))
(defun fingerprint (root entries)
  (arr (mapcar (lambda (e)
                 (let* ((name (cdr e)) (file (path root name))
                        (exists (ignore-errors (sb-posix:lstat file))))
                   (when (and (equal (car e) "??") (not exists))
                     (fail "source-drift" "A new file disappeared during fingerprinting."
                           "Run again when edits are stable."))
                   (obj "path" name "status" (car e) "mode" (if exists (file-mode file) "deleted")
                        "hash" (if exists (hash-file file) :null))))
               entries)))
(defun same-json (a b) (string= (json a) (json b)))
(defun protected-fingerprint (root session)
  (arr (map 'list (lambda (name)
                    (let ((file (path root name)))
                      (unless (probe-file file)
                        (fail "protected-missing" (format nil "Protected input is missing: ~a" name)
                              "Restore it or initialize a new session."))
                      (obj "path" name "hash" (hash-file file) "mode" (file-mode file))))
            (field session "protected"))))
(defun inside-project (root file)
  (let ((real (namestring (truename (path root file)))))
    (unless (and (<= (length root) (length real))
                 (string= root real :end2 (length root)))
      (fail "path-escape" (format nil "Path resolves outside project: ~a" file)
            "Use only project-owned regular paths." 2))))
(defun validate-identity (root session)
  (unless (and (equal root (field session "root"))
               (equal (trim (git root "rev-parse" "--git-dir"))
                      (field session "git-dir"))
               (equal (trim (git root "symbolic-ref" "--quiet" "--short" "HEAD"))
                      (field session "branch")))
    (fail "identity-drift" "Worktree identity or branch changed."
          "Return to the original worktree and branch; do not reset Git during a candidate.")))
(defun protected-required (root session)
  (unless (same-json (protected-fingerprint root session) (field session "fingerprint"))
    (fail "evaluator-drift" "Protected benchmark/check/input changed."
          "Restore the protected evaluator or start a fresh session and baseline.")))

(defun session-file (root) (path root ".auto/session.json"))
(defun events-file (root) (path root ".auto/events.jsonl"))
(defun load-session (root)
  (unless (probe-file (session-file root))
    (fail "no-session" "No hillclimber session exists in this worktree."
          "Run hillclimber init once, or pass --project with the session worktree."))
  (handler-case (parse-json (uiop:read-file-string (session-file root)))
    (error () (fail "session-corrupt" "Invalid session.json." "Restore the session file from backup." 5))))
(defun sync-stream (stream)
  (finish-output stream)
  (sb-posix:fsync (sb-sys:fd-stream-fd stream)))
(defun sync-directory (directory)
  (let ((fd (sb-posix:open (namestring (uiop:ensure-directory-pathname directory))
                           sb-posix:o-rdonly 0)))
    (unwind-protect (sb-posix:fsync fd)
      (sb-posix:close fd))))
(defun write-json-file (name value)
  (with-open-file (f name :direction :output :if-exists :error :external-format :utf-8)
    (write-line (json value) f) (sync-stream f)))
(defun append-event (root event)
  (setf (gethash "v" event) 1)
  (with-open-file (f (events-file root) :direction :output :if-exists :append
                                           :external-format :utf-8)
    (write-line (json event) f) (sync-stream f))
  event)
(defun journal-bytes (root)
  (unless (probe-file (events-file root))
    (fail "journal-missing" "Missing events journal." "Restore session events from backup." 5))
  (with-open-file (f (events-file root) :element-type '(unsigned-byte 8))
    (let ((buf (make-array (file-length f) :element-type '(unsigned-byte 8))))
      (read-sequence buf f) buf)))
(defun journal-prefix (bytes)
  (or (position 10 bytes :from-end t) -1))
(defun journal (root &optional allow-tail)
  (let* ((bytes (journal-bytes root)) (end (1+ (journal-prefix bytes)))
         (events nil))
    (when (and (< end (length bytes)) (not allow-tail))
      (fail "journal-truncated" "Journal ends in an incomplete record."
            "Run recover; it preserves the original bytes before trimming the final fragment." 5))
    (loop for start = 0 then (1+ newline)
          for newline = (position 10 bytes :start start :end end)
          while newline do
            (handler-case
                (let ((e (parse-json
                          (sb-ext:octets-to-string bytes :start start :end newline
                                                   :external-format :utf-8))))
                  (unless (and (hash-table-p e) (= (field e "v" -1) 1)
                               (member (field e "type")
                                       '("baseline" "begin" "attempt-start" "attempt" "aggregate"
                                         "intent" "cancel-intent" "applied" "resolved")
                                       :test #'equal))
                    (error "invalid event"))
                  (push e events))
              (error () (fail "journal-corrupt" "Journal has an invalid complete record."
                              "Preserve its bytes and restore a trusted backup; mutation is blocked." 5))))
    (nreverse events)))
(defun state (root &optional allow-tail)
  (let ((baseline nil) (best nil) (accepted nil) (pending nil)
        (attempt nil) (intent nil) (applied nil) (runs 0) (candidates 0)
        (decisions 0) (history nil))
    (dolist (e (journal root allow-tail))
      (let ((type (field e "type")))
        (cond
          ((equal type "baseline")
           (setf baseline e best (field e "score") accepted (field e "head"))
           (incf runs (field e "count")))
          ((equal type "begin") (setf pending e attempt nil intent nil applied nil)
           (incf candidates))
          ((equal type "attempt-start") (incf runs) (setf attempt e))
          ((member type '("attempt" "aggregate") :test #'equal)
           (setf attempt e) (push e history))
          ((equal type "intent") (setf intent e) (incf decisions))
          ((equal type "cancel-intent") (setf intent nil))
          ((equal type "applied") (setf applied e))
          ((equal type "resolved")
           (when (equal (field e "action") "keep")
             (setf accepted (field e "head") best (field e "score")))
           (setf pending nil attempt nil intent nil applied nil) (push e history)))))
    (obj "baseline" (or baseline :null) "best" (or best :null)
         "accepted" (or accepted :null) "pending" (or pending :null)
         "attempt" (or attempt :null) "intent" (or intent :null)
         "applied" (or applied :null) "runs" runs "candidates" candidates
         "decisions" decisions
         "history" (arr (nreverse history)))))
(defun real-field (o key) (let ((x (field o key))) (and (numberp x) x)))
(defun with-session-lock (root thunk)
  (with-open-file (s (path root ".auto/session.lock") :direction :io
                      :if-does-not-exist :create :if-exists :overwrite)
    (let ((fd (sb-sys:fd-stream-fd s)))
      (handler-case (sb-posix:lockf fd sb-posix:f-tlock 0)
        (error () (fail "locked" "Another hillclimber writer owns this session."
                        "Wait for it to finish; status is still available.")))
      (unwind-protect (funcall thunk)
        (sb-posix:lockf fd sb-posix:f-ulock 0)))))
